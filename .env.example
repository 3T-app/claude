# Claude API キー（未設定だとデモ表示で動きます）
ANTHROPIC_API_KEY=
# 使うモデル（省略時 claude-opus-5-5）
# CLAUDE_MODEL=claude-opus-5-5
# 運営画面 /admin の合言葉（好きな文字。例：shoken2026）。npm run phone で起動するときは必ず設定
ADMIN_TOKEN=
# 1 にするとキーがあってもデモ表示
# DEMO_MODE=1

# ── AIへの質問の支払い（1回100円） ──
# Stripe のシークレットキー（https://dashboard.stripe.com/apikeys）。sk_test_… なら Stripe のテストモードで動作確認できます
# 未設定だと「テスト決済」になり、実際には請求せずに回答します（公開する前に必ず設定してください）
STRIPE_SECRET_KEY=

# ── AIが自動で使う外部データ（どれも無料・審査なし。未設定なら使わずに動きます） ──
# YouTube Data API v3：Google Cloud でキーを発行し「YouTube Data API v3」を有効化
YOUTUBE_API_KEY=
# ホットペッパーグルメ Webサービス：https://webservice.recruit.co.jp/ でメール登録
HOTPEPPER_API_KEY=
# e-Stat：https://www.e-stat.go.jp/api/ で利用登録して appId を発行
ESTAT_APP_ID=
# 使う統計表（省略時は社会・人口統計体系 市区町村データ）
# ESTAT_STATS_DATA_ID=0000020201

# ── 周りの店の評価・口コミの数・価格帯（Google マップ） ──
# 食べログには公式の公開APIがないため、代わりに Google Places API（New）を使います。
# 発行のしかた：Google Cloud コンソール（https://console.cloud.google.com/）→ YouTube と同じプロジェクトでよい
#   →「API とサービス」→「ライブラリ」で「Places API (New)」を有効にする →「認証情報」→「API キーを作成」
#   → キーの「API の制限」で Places API (New) だけに絞る。お支払い情報（カード）の登録が必要です
#   （評価・口コミ数は月ごとの無料枠があり、超えると有料。Google Cloud の「予算とアラート」で上限を決めておくと安心）
GOOGLE_PLACES_API_KEY=

# ── 韓国の検索トレンド（Naver DataLab 検索語トレンド） ──
# 新しく発行する人は NAVER API HUB（NAVER Cloud Platform のコンソール）で「検索語トレンド」を申し込み、
# 出てきた2つのキーを入れてください。見る言葉は data/global-watch.json で変えられます。
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=
# 以前の Naver Developers のアプリのキーを持っている人は、こちらでも動きます（上が空のとき使います）
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# 呼び出し先のURLが変わったときだけ設定（ふだんは空でよい）
# NAVER_DATALAB_URL=

# ── 周りのレストランの評価・口コミの数（Tripadvisor。無料の範囲で使います） ──
# 発行のしかた：Tripadvisor の開発者向けページ（Content API）でアカウントを作り、API キーを発行。
#   キーには使う場所の制限（ドメインかIPアドレス）を設定します。自分のパソコンで使うときは、そのパソコンのIPアドレスを登録してください。
#   無料の範囲を超えた分はカードに請求されるため、アプリは月ごとの呼び出し回数を数え、下の上限で止まります
#   （1回の立地調査で最大5回。無料の回数が減ったときは、上限を小さくしてください）
TRIPADVISOR_API_KEY=
# 1か月の上限（省略時 900）
# TRIPADVISOR_MONTHLY_LIMIT=900
# 新しい API（Terra）に切り替わって呼び出し先が変わったときだけ設定
# TRIPADVISOR_API_BASE=
